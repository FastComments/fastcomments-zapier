# OAuth client FastComments registered for Zapier. Set the same values in Zapier with
# `zapier-platform env:set <version> CLIENT_ID=... CLIENT_SECRET=...`.
CLIENT_ID=
CLIENT_SECRET=

# Live test lane (npm run test:live). Leave unset to skip it.
# Base URL of the FastComments server to test against, for example http://localhost:3001.
FC_ZAPIER_LIVE_BASE_URL=
# A refresh token issued to the client above. First-party refresh tokens do not rotate, so this stays valid.
FC_ZAPIER_LIVE_REFRESH_TOKEN=
